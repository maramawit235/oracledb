# ==============================================================================
# Oracle DB Health Monitoring Suite - Environment Configuration Template
# Copy this file to .env and configure your environment credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ORACLE DATABASE CONNECTION (Supports Oracle XE and Oracle 19c)
# ------------------------------------------------------------------------------
# Oracle Database Host (IP or hostname). Local XE: 10.73.34.37 / localhost.
ORACLE_HOST=10.73.34.37
ORACLE_PORT=1521
# Oracle Service Name / SID. XEPDB1 / XE
ORACLE_SERVICE_NAME=XEPDB1
# Oracle Monitoring User Credentials (created via create_monitoring_user.sql)
ORACLE_USER=monitor
ORACLE_PASSWORD=qwertyuiop
# Combined Easy Connect DSN String
ORACLE_DSN=monitor/qwertyuiop@10.73.34.37:1521/XEPDB1

# ------------------------------------------------------------------------------
# 2. PROMETHEUS & EXPORTER ENDPOINTS
# ------------------------------------------------------------------------------
# Prometheus Server REST API endpoint for PromQL queries (leave blank if unused)
PROMETHEUS_URL=
# Oracle DB Exporter raw metrics endpoint (leave blank if unused)
EXPORTER_URL=

# ------------------------------------------------------------------------------
# 3. NOTIFICATION & ALERT CHANNEL CREDENTIALS
# ------------------------------------------------------------------------------
# Incoming Slack Webhook URL for posting alert cards
SLACK_WEBHOOK_URL=

# SMTP Email Server Configuration for Email Alerts
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_SENDER_EMAIL=
ALERT_RECIPIENT_EMAILS=mesualegn@gmail.com

# Generic Webhook Endpoint for external SIEM / PagerDuty / OpsGenie integration
GENERIC_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. ENGINE TUNING & COOLDOWN SETTINGS
# ------------------------------------------------------------------------------
# Alert deduplication cooldown period in seconds (e.g. 300 = 5 minutes)
ALERT_COOLDOWN_SECONDS=300
# Path to rules configuration YAML file
RULES_CONFIG_FILE=rules.yaml
